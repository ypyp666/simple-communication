# 复制为 .env 后填入真实值，.env 不要提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_SEARCH_URL=
DEEPSEEK_FETCH_URL=

# 模型名，不填默认 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# 图片理解专家用的视觉模型，留空则复用 DEEPSEEK_MODEL
DEEPSEEK_VISION_MODEL=

# 服务监听地址（默认只监听本机，Qt 客户端直连）
AGENT_HOST=127.0.0.1
AGENT_PORT=9000

# 业务数据库：查好友、拉聊天记录都要用它
# 这个账号只需要存储过程的 EXECUTE 权限，不需要表的 SELECT 权限
AGENT_DB_HOST=192.168.20.128
AGENT_DB_PORT=3306
AGENT_DB_USER=
AGENT_DB_PASSWORD=
AGENT_DB_NAME=User
# 连不上库时的超时秒数，别设太大，否则会卡住整条对话
AGENT_DB_CONNECT_TIMEOUT=5
